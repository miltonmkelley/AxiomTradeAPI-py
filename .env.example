# Single account mode (backwards compatible)
AUTH_TOKEN=your_auth_access_token
REFRESH_TOKEN=your_auth_refresh_token

# Multi-account mode for rotation (optional)
# AXIOM_AUTH_TOKEN_1=first_account_auth_token
# AXIOM_REFRESH_TOKEN_1=first_account_refresh_token
# AXIOM_AUTH_TOKEN_2=second_account_auth_token
# AXIOM_REFRESH_TOKEN_2=second_account_refresh_token
# (add more as AXIOM_AUTH_TOKEN_3, etc.)

# Proxies from file (Webshare format: ip:port:login:pass)
# AXIOM_PROXY_FILE=/path/to/proxies.txt

# Or comma-separated proxy URLs
# AXIOM_PROXIES=http://user:pass@proxy1:port,http://user:pass@proxy2:port

# Login credentials (optional, for OTP-based auth)
# email=your_email@example.com
# password=your_password